{
  "name": "ai-in-public-motion-reel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "logo": "remotion still src/index.ts LogoMark public/logo-mark.png --image-format=png --browser-executable=$CHROME",
    "points": "node scripts/logo-points.mjs",
    "grain": "node scripts/grain.mjs",
    "music": "node scripts/music.mjs && sh scripts/master.sh",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Reel out/ai-in-public-reel.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=320k --concurrency=4 --browser-executable=$CHROME"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@remotion/cli": "^4.0.532",
    "@remotion/motion-blur": "^4.0.532",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}

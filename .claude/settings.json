{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes"
      }
    },
    "claude-animation-skill": {
      "source": {
        "source": "github",
        "repo": "buildwithhanif/claude-animation-skill"
      }
    }
  },
  "enabledPlugins": {
    "hyperframes@hyperframes": true,
    "claude-animation@claude-animation-skill": true
  }
}
